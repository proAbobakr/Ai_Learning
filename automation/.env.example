# Email Configuration for n8n Workflow
# Copy this file to .env and fill in your actual values

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email Recipients
EMAIL_FROM=crawler@example.com
EMAIL_TO=team@example.com

# Crawler Settings
CRAWLER_CONFIG_PATH=automation/crawler/config/crawler_config.json

# Optional: Notification Webhooks
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# n8n Configuration (if self-hosting)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
